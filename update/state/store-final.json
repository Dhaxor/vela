  "vela.chapter.v2.mve7u3o9-dxcgnl": {
    "storedAs": "file 1ff1d810d7011c368a7be2531c1f7a86",
    "length": 2422,
    "value": {
      "id": "mve7u3o9-dxcgnl",
      "dreamId": "mve7tc04-8kywog",
      "season": 1,
      "number": 2,
      "stage": 2,
      "title": "After the Wanting",
      "revision": 1,
      "writtenAt": "2026-10-18T19:25:50.746Z",
      "source": "migrated-v1",
      "wovenProofId": null,
      "opening": {
        "morning": {
          "key": "p0",
          "fragmentId": "v1:op7",
          "beat": "opening",
          "text": "The day doesn't ask anything of you yet. It just waits, warm and unhurried, while you remember who you've become.",
          "spans": []
        },
        "evening": {
          "key": "p0",
          "fragmentId": "v1:op7",
          "beat": "opening",
          "text": "The day doesn't ask anything of you yet. It just waits, warm and unhurried, while you remember who you've become.",
          "spans": []
        }
      },
      "body": [
        {
          "key": "p1",
          "fragmentId": "v1:ar-ca2",
          "beat": "arrival",
          "text": "The first task of the day is one you'd do for free — and they pay you well for it. Strange and wonderful, how the intention held: my own design studio, with clients who trust my eye.",
          "spans": []
        },
        {
          "key": "p2",
          "fragmentId": "v1:se3",
          "beat": "sensory",
          "text": "The air outside smells faintly of rain that already fell. Everything is rinsed, including — somehow — you.",
          "spans": []
        },
        {
          "key": "p3",
          "fragmentId": "v1:li-ca3",
          "beat": "living",
          "text": "You decline a shiny thing that isn't yours to do, and the calendar breathes. Mastery is mostly subtraction, you've learned.",
          "spans": []
        },
        {
          "key": "p4",
          "fragmentId": "v1:wi7",
          "beat": "living",
          "text": "Someone younger watches how you move through the day and quietly adjusts their own sails. You remember being them. You'd have loved proof like you.",
          "spans": []
        },
        {
          "key": "p5",
          "fragmentId": "v1:gr6",
          "beat": "reflection",
          "text": "Somewhere in the day you feel it land — that this was once the dream. This exact, ordinary, extraordinary Tuesday. You feel proud, all the way through.",
          "spans": []
        },
        {
          "key": "p6",
          "fragmentId": "v1:proof-2",
          "beat": "recall",
          "text": "There is proof behind this memory now: Sent my portfolio to two studios I admire. It is small enough to be real, and real enough to change what comes next.",
          "spans": []
        }
      ],
      "closing": {
        "morning": {
          "key": "p7",
          "fragmentId": "v1:cl2",
          "beat": "closing",
          "text": "You set tomorrow's one intention like a cup by the kettle, then let the day go completely. Sleep comes down like warm weather.",
          "spans": []
        },
        "evening": {
          "key": "p7",
          "fragmentId": "v1:cl2",
          "beat": "closing",
          "text": "You set tomorrow's one intention like a cup by the kettle, then let the day go completely. Sleep comes down like warm weather.",
          "spans": []
        }
      },
      "wordCount": {
        "morning": 196,
        "evening": 196
      },
      "engineVersion": 1
    }
  },
  "vela.chapter.v2.mve7ubk6-4e83fu": {
    "storedAs": "file dbeb7029a11ab5ccf9e47cd59e409009",
    "length": 2125,
    "value": {
      "id": "mve7ubk6-4e83fu",
      "dreamId": "mve7ubj2-f3ne9z",
      "season": 1,
      "number": 1,
      "stage": 1,
      "title": "After the Wanting",
      "revision": 1,
      "writtenAt": "2026-10-18T19:26:00.966Z",
      "source": "migrated-v1",
      "wovenProofId": null,
      "opening": {
        "morning": {
          "key": "p0",
          "fragmentId": "v1:op9",
          "beat": "opening",
          "text": "No scramble, no dread, no list running before your feet touch the floor. Just morning, and you, and the life that answered.",
          "spans": []
        },
        "evening": {
          "key": "p0",
          "fragmentId": "v1:op9",
          "beat": "opening",
          "text": "No scramble, no dread, no list running before your feet touch the floor. Just morning, and you, and the life that answered.",
          "spans": []
        }
      },
      "body": [
        {
          "key": "p1",
          "fragmentId": "v1:ar-ab6",
          "beat": "arrival",
          "text": "You tip well. You book the trip. You breathe. Enough stopped being a ceiling and became a floor: A home by the sea.",
          "spans": []
        },
        {
          "key": "p2",
          "fragmentId": "v1:se10",
          "beat": "sensory",
          "text": "Your own handwriting in the margin of today's list looks different lately. Rounder. Unclenched.",
          "spans": []
        },
        {
          "key": "p3",
          "fragmentId": "v1:li-ab3",
          "beat": "living",
          "text": "An opportunity lands in your inbox — the paid kind, the aligned kind. They find you regularly now, like the address finally got listed.",
          "spans": []
        },
        {
          "key": "p4",
          "fragmentId": "v1:wi7",
          "beat": "living",
          "text": "Someone younger watches how you move through the day and quietly adjusts their own sails. You remember being them. You'd have loved proof like you.",
          "spans": []
        },
        {
          "key": "p5",
          "fragmentId": "v1:gr1",
          "beat": "reflection",
          "text": "Gratitude arrives on its own now, uninvited, mid-afternoon — for the ordinary furniture of a life you once begged the sky for.",
          "spans": []
        }
      ],
      "closing": {
        "morning": {
          "key": "p6",
          "fragmentId": "v1:cl6",
          "beat": "closing",
          "text": "Sleep takes you gently, the way it takes people with nothing to flee. Tomorrow will rhyme with today. That's the whole plan now.",
          "spans": []
        },
        "evening": {
          "key": "p6",
          "fragmentId": "v1:cl6",
          "beat": "closing",
          "text": "Sleep takes you gently, the way it takes people with nothing to flee. Tomorrow will rhyme with today. That's the whole plan now.",
          "spans": []
        }
      },
      "wordCount": {
        "morning": 151,
        "evening": 151
      },
      "engineVersion": 1
    }
  },
  "vela.chapter.v2.mve7ubk6-4e83fu-w": {
    "storedAs": "file 5deb91d3ff8f3bf784c26ac3a325f7bf",
    "length": 3807,
    "value": {
      "id": "mve7ubk6-4e83fu-w",
      "dreamId": "mve7ubj2-f3ne9z",
      "season": 1,
      "number": 2,
      "stage": 2,
      "title": "What Tomorrow Makes Possible",
      "revision": 1,
      "writtenAt": "2026-10-18T19:29:12.341Z",
      "source": "engine",
      "wovenProofId": "mve7ubk7-78z3z3",
      "opening": {
        "morning": {
          "key": "p0",
          "fragmentId": "sh2-op-m3",
          "beat": "opening",
          "text": "A rehearsal is a good way to start a morning, Maya. In this chapter it is the night before a day that matters. You are putting your things in order without any rush at all. Watch how calmly you do it.",
          "spans": [
            {
              "kind": "name",
              "start": 46,
              "end": 50
            }
          ]
        },
        "evening": {
          "key": "p0",
          "fragmentId": "sh2-op-e3",
          "beat": "opening",
          "text": "Dim the room a little, Maya, and lower your voice inside your head. It is late evening in this story, and tomorrow the life you wrote down takes a real step forward. Notice how ready you already are. Notice how little there is left to do.",
          "spans": [
            {
              "kind": "name",
              "start": 23,
              "end": 27
            }
          ]
        }
      },
      "body": [
        {
          "key": "p1",
          "fragmentId": "ab2-ar5",
          "beat": "arrival",
          "text": "Tomorrow your friends see the place for the first time. You have moved the sofa three times and changed your mind about the rug twice. Flowers wait in a jug in the sink. You stand in the doorway, pleased and nervous in equal measure, because you have a home by the sea.",
          "spans": [
            {
              "kind": "desire",
              "start": 242,
              "end": 268
            }
          ]
        },
        {
          "key": "p2",
          "fragmentId": "sh2-se3",
          "beat": "sensory",
          "text": "The washing up is done and drying on the rack. The dark window shows you a faint reflection of the room, and of you in it. You look at that reflection a second longer than usual. The person in it looks tired in a good way, and ready, and steadier than you remember.",
          "spans": []
        },
        {
          "key": "p3",
          "fragmentId": "ab2-li2",
          "beat": "living",
          "text": "Someone calls to wish you luck for tomorrow. You hear yourself talking about money without shame for the first time, plainly, numbers and all. They tell you they are proud of you. You had no idea how much you needed someone to say it until they did.",
          "spans": []
        },
        {
          "key": "p4",
          "fragmentId": "mo-home-li1",
          "beat": "motif",
          "text": "You close the front door behind you and the click sounds different. It is your door. You drop your keys in the bowl, kick off your shoes and smile at nothing.",
          "spans": []
        },
        {
          "key": "p5",
          "fragmentId": "wv-m-wi5",
          "beat": "weave",
          "text": "Someone impatient with their own progress asks how you did it. You give them yours: “Saved the first two hundred for the deposit”. You tell them it counted. Hearing yourself say it, you finally believe it too.",
          "spans": [
            {
              "kind": "proof",
              "start": 84,
              "end": 129,
              "proofId": "mve7ubk7-78z3z3"
            }
          ],
          "wovenProofId": "mve7ubk7-78z3z3"
        },
        {
          "key": "p6",
          "fragmentId": "sh2-re3",
          "beat": "reflection",
          "text": "Readiness turns out to be quieter than you pictured. There is no drumroll. There is only a sense that whatever tomorrow brings, you will meet it as yourself. That is what all the small steps toward a home by the sea were building, all along. Something in you feels peaceful, and steady with it.",
          "spans": [
            {
              "kind": "desire",
              "start": 198,
              "end": 215
            }
          ]
        }
      ],
      "closing": {
        "morning": {
          "key": "p7",
          "fragmentId": "sh2-cl-m4",
          "beat": "closing",
          "text": "This is how big days get built: on ordinary mornings, one piece at a time. Look around the room you are actually in, and choose one piece to carry today. The choices are just below. Pick the one that feels almost too easy.",
          "spans": []
        },
        "evening": {
          "key": "p7",
          "fragmentId": "sh2-cl-e2",
          "beat": "closing",
          "text": "Set down the rehearsal. You know your part, every line of it. Breathe like someone who has checked what needed checking and has run out of things to do. Then let the night take over, and go with it.",
          "spans": []
        }
      },
      "wordCount": {
        "morning": 358,
        "evening": 359
      },
      "engineVersion": 2,
      "usedIds": [
